# VoiceSpec Environment Variables
# Copy this file to .env.local and fill in the values

# Gemini API key (optional — app runs in demo mode without it)
# IMPORTANT: Never log or commit this key
GEMINI_API_KEY=

# Gemini model name (defaults to gemini-3.5-flash)
GEMINI_MODEL=gemini-3.5-flash

# Optional fallback model in case the primary model is busy (returns 503 or 429)
GEMINI_FALLBACK_MODEL=gemini-3.1-flash-lite

# Force demo mode (skips Gemini entirely, even if API key is set)
# Set to 'true' to enable. WARNING: This must never be set in production.
FORCE_DEMO_MODE=
